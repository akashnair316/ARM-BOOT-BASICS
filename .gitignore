# ===============================
# Generic .gitignore for Embedded C / ASM / BSP Projects
# ===============================

# --- Build Artifacts ---
*.o
*.obj
*.ko
*.elf
*.axf
*.map
*.out
*.bin
*.hex
*.lst
*.srec
*.dump

# --- Intermediate Compilation Files ---
*.d        # Dependency files generated by gcc/clang
*.su       # Gcov intermediate files
*.gcno
*.gcda
*.gcov

# --- Linker/Debug ---
*.ld       # Linker scripts (if generated; keep if manually maintained)
*.dbg
*.pdb

# --- Toolchain Specific ---
# GCC/Clang
*.a
*.so
*.dylib
*.lib

# Keil / ARMCC
*.uvproj*
*.uvopt*
*.uvguix.*
*.scvd

# IAR
*.ewp
*.eww
*.ewd
*.ewt

# --- BSP / Kernel Build ---
*.cmd
*.symvers
*.order
*.mod
*.mod.c
modules.order
Module.symvers

# --- Logs / Dumps ---
*.log
*.bak
*.swp
*.tmp
*.DS_Store
*~

# --- IDE Specific ---
# VS Code
#.vscode/
# CLion / JetBrains
.idea/
cmake-build*/

# --- Autotools / Make ---
Makefile.in
/aclocal.m4
/autom4te.cache/
/compile
/config.guess
/config.log
/config.status
/config.sub
/configure
/depcomp
/install-sh
/libtool
/ltmain.sh
/missing

# --- CMake ---
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
CTestTestfile.cmake
*.cmake

# --- Output Directories ---
build/
out/
obj/
bin/
Debug/
Release/

# --- Misc ---
tags
*.tag
*.ctags
*.etags
